QWidget { font-family: "Microsoft YaHei UI"; font-size: 13px; color: #F5F7FA; }
QMainWindow, QStackedWidget, #workspace { background: #0D0F14; }
#coverPage, #coverPage QWidget, #coverPage QScrollArea, #coverPage QScrollArea > QWidget { background: @color.background; color: @color.text_primary; }
#songHeader { background: transparent; border: 0; }
#coverArt { background: qlineargradient(x1:0,y1:1,x2:1,y2:0, stop:0 #111A35, stop:.48 #303E9F, stop:1 #6A5CFF); border-radius: 16px; border: 1px solid #343E73; }
#eyebrow, #sectionLabel { color: #7F899B; font-size: 10px; font-weight: 700; }
#songTitle { font-size: 25px; font-weight: 760; color: #F6F8FC; }
#timelineCard, #lyricsCard, #mixerCard, #coverSettings { background: @color.surface; border: 1px solid @color.border; border-radius: 16px; }
#timelineCard > QVBoxLayout > QHBoxLayout, #lyricsCard > QVBoxLayout > QHBoxLayout, #mixerCard > QVBoxLayout > QHBoxLayout { min-height: 46px; border-bottom: 1px solid #1B2330; }
#tracks { background: #0D121B; }
#cardTitle { color: #E9EDF5; font-size: 12px; font-weight: 720; }
#cardSub, #muted { color: #667085; font-size: 10px; }
#miniChip, #capabilities { color: #A8A0FF; background: #181B32; border: 1px solid #30325D; border-radius: 7px; padding: 4px 8px; font-size: 10px; }
#miniButton { min-height: 26px; padding: 4px 9px; border-radius: 7px; font-size: 10px; }
#mixerLabel { color: #7F899A; font-size: 10px; min-width: 54px; }
#mixerValue { color: #7B8494; font-size: 9px; min-width: 28px; }
#mixerNote, #settingsNote { color: #667085; background: #0C121A; border: 1px solid #19212D; border-radius: 8px; padding: 8px; font-size: 9px; }
#rightsState { color: #D7DCEE; background: #171D2B; border-radius: 8px; padding: 7px; font-size: 10px; }
#settingToggle { color: #CFD5E1; padding: 4px 0; }
#globalTransport, #transportWidget { min-height: 58px; background: #0A0D13; border-top: 1px solid #171D28; }
#globalTransport QPushButton, #transportWidget QPushButton { min-width: 34px; padding: 5px 9px; }
#coverPage QSlider::groove:horizontal { height: 3px; background: #273041; border-radius: 2px; }
#coverPage QSlider::handle:horizontal { width: 12px; margin: -5px 0; border-radius: 6px; background: #8A82FF; border: 1px solid #A8A0FF; }
#coverPage QSpinBox, #coverPage QComboBox { background: #0C121B; border: 1px solid #273142; border-radius: 8px; padding: 6px; }
#sidebar { background: #11141B; border-right: 1px solid #20242E; }
#topbar { min-height: 72px; background: rgba(9, 11, 16, 220); border-bottom: 1px solid #131924; }
#topbar QLabel { color: #7D8799; font-size: 12px; }
#topbarTitle { color: #E9EDF5; font-size: 14px; font-weight: 700; }
#topbarStatus { color: #A3D9B1; background: #1D2922; border-radius: 8px; padding: 6px 9px; font-size: 10px; }
#topbarButton { min-height: 28px; padding: 5px 11px; font-size: 11px; }
#brand { color: #FFFFFF; font-size: 22px; font-weight: 700; padding: 22px 16px 4px 16px; }
#brandSub { color: #6F7685; font-size: 11px; padding: 0 16px 14px 16px; }
#projectPicker { color: #D9DDE5; background: #191D26; border: 1px solid #262B36; border-radius: 8px; margin: 0 12px 16px 12px; padding: 9px; text-align: left; }
#navSection { color: #697180; font-size: 11px; font-weight: 600; padding: 12px 18px 4px 18px; }
#sidebarFoot { color: #697180; padding: 12px 16px 18px 16px; font-size: 11px; }
#sidebarButton { margin: 4px 12px; background: #191D26; color: #BCC2CE; border: 1px solid #262B36; }
#navigation { background: transparent; color: #A7ADBA; outline: none; border: 0; }
#navigation::item { padding: 11px 14px; margin: 2px 10px; border-radius: 8px; }
#navigation::item:hover { background: #191D26; color: #F5F7FA; }
#navigation::item:selected { background: #24283A; color: #AEB7FF; border-left: 3px solid #7381FF; }
#pageTitle { font-size: 25px; font-weight: 700; color: #F5F7FA; }
#hint, #muted { color: #9299A8; }
#studioCard, #coverSettings, #stemTrack, #lyricView { background: #151821; border: 1px solid #222733; border-radius: 12px; }
#dialogTitle { font-size: 17px; font-weight: 700; color: #F5F7FA; }
#cardTitleSmall { font-size: 13px; font-weight: 700; color: #E8EAF0; }
#statusChip { color: #AEB7FF; background: #22273A; border-radius: 9px; padding: 3px 9px; }
#dangerChip { color: #FFB4B4; background: #3A2428; border-radius: 9px; padding: 3px 9px; }
#issueWarning { color: #EBCB8B; background: #28251E; border-radius: 6px; padding: 6px; }
#issueGood { color: #A3D9B1; background: #1D2922; border-radius: 6px; padding: 6px; }
#inlinePlayer, #dropArea { background: #151821; border: 1px solid #292E3A; border-radius: 9px; }
#dropTitle { color: #AEB7FF; font-size: 16px; font-weight: 600; }
#emptyState { color: #7C8391; font-size: 16px; padding: 28px; }
#recordPrompt { background: #151821; border: 1px solid #292E3A; border-radius: 8px; padding: 18px; font-size: 17px; }
QLineEdit, QPlainTextEdit, QTextBrowser, QComboBox, QSpinBox, QDoubleSpinBox, QTableWidget, QListWidget { background: #151821; border: 1px solid #2A303C; border-radius: 7px; padding: 6px; selection-background-color: #5865D8; }
QGroupBox { border: 0; border-radius: 10px; margin-top: 10px; padding: 12px; background: #151821; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: #B9BFCA; }
QPushButton, QToolButton { min-height: 20px; background: #1C202B; border: 1px solid #303644; border-radius: 7px; padding: 7px 13px; color: #D8DCE4; }
QPushButton:hover, QToolButton:hover { background: #252A37; border-color: #424A5B; }
QPushButton:pressed { background: #181C25; }
QPushButton:disabled { color: #626A78; background: #171A21; border-color: #242832; }
#primaryButton { background: @color.accent; border-color: #6877F1; color: white; font-weight: 600; }
#primaryButton:hover { background: #6675EF; }
QProgressBar { border: 0; border-radius: 4px; text-align: center; background: #20242E; }
QProgressBar::chunk { background: #7381FF; border-radius: 4px; }
QSlider::groove:horizontal { height: 4px; background: #2A303C; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #8792FF; }
QScrollBar:vertical { width: 9px; background: transparent; }
QScrollBar::handle:vertical { background: #333946; border-radius: 4px; min-height: 24px; }
QStatusBar { background: #11141B; color: #858C9A; border-top: 1px solid #20242E; }

/* Cover page inline theme, kept here so the page also renders correctly when
   the shared studio stylesheet is loaded by the application shell. */
#coverPage { background: #0B1020; color: #E5E7EB; }
QLabel#title { font-size: 28px; font-weight: 700; color: #FFFFFF; }
QLabel#muted { color: #8B95A7; }
QFrame#settings { background: #151C2F; border: 1px solid #283452; border-radius: 14px; }
#coverPage QPlainTextEdit, #coverPage QComboBox, #coverPage QSpinBox {
    background: #121A2C; color: #E5E7EB; border: 1px solid #33415F;
    border-radius: 7px; padding: 7px;
}
#coverPage QPushButton {
    background: #1B2640; color: #E5E7EB; border: 1px solid #3B4D76;
    border-radius: 7px; padding: 9px 14px;
}
#coverPage QPushButton#primaryButton { background: #7C3AED; color: #FFFFFF; }
#coverPage QPushButton:disabled { color: #626A78; background: #171A21; border-color: #242832; }
#trackStatus { color: #AEB7FF; background: #22273A; border-radius: 7px; padding: 3px 6px; }
#trackStatus[state="processing"] { color: #EBCB8B; background: #28251E; }
#trackStatus[state="error"] { color: #FFB4B4; background: #3A2428; }
#trackStatus[state="empty"] { color: #9299A8; background: #20242E; }
#lyricView { background: #0D121B; border: 0; border-radius: 0; padding: 8px 10px; outline: none; }
#lyricView::item { color: #5F6879; padding: 7px 8px; border-radius: 8px; }
#lyricView::item:hover { color: #AEB8C7; background: #151C27; }
#lyricView::item:selected { color: #FFFFFF; background: #262044; border-left: 2px solid #8F82FF; }
